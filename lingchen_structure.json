 "lines": [
  {
   "i": 1,
   "start": 13.8,
   "end": 17.8,
   "text": "末班车把城市留在身后"
  },
  {
   "i": 2,
   "start": 18.966,
   "end": 22.966,
   "text": "路灯沿着海岸缓缓退走"
  },
  {
   "i": 3,
   "start": 22.966,
   "end": 27.166,
   "text": "你把车窗摇下一点点"
  },
  {
   "i": 4,
   "start": 28.066,
   "end": 32.166,
   "text": "风就把沉默吹成温柔"
  },
  {
   "i": 5,
   "start": 34.6,
   "end": 38.933,
   "text": "便利店的灯还亮在街口"
  },
  {
   "i": 6,
   "start": 39.8,
   "end": 43.733,
   "text": "两杯汽水冒着细小宇宙"
  },
  {
   "i": 7,
   "start": 43.733,
   "end": 47.866,
   "text": "我们没有谈明天多远"
  },
  {
   "i": 8,
   "start": 49.0,
   "end": 53.066,
   "text": "只听浪花回答了很久"
  },
  {
   "i": 9,
   "start": 53.5,
   "end": 58.3,
   "text": "时间停在蓝色以外"
  },
  {
   "i": 10,
   "start": 58.7,
   "end": 63.5,
   "text": "心跳藏进潮汐等待"
  },
  {
   "i": 11,
   "start": 64.0,
   "end": 68.766,
   "text": "你转过脸笑了一下"
  },
  {
   "i": 12,
   "start": 69.166,
   "end": 74.0,
   "text": "整片夜空忽然盛开"
  },
  {
   "i": 13,
   "start": 74.4,
   "end": 76.866,
   "text": "凌晨两点的海"
  },
  {
   "i": 14,
   "start": 78.3,
   "end": 82.5,
   "text": "把月光推到我们脚边来"
  },
  {
   "i": 15,
   "start": 83.5,
   "end": 87.166,
   "text": "所有没说出口的期待"
  },
  {
   "i": 16,
   "start": 88.766,
   "end": 94.866,
   "text": "都在浪尖变成银白"
  },
  {
   "i": 17,
   "start": 95.3,
   "end": 97.7,
   "text": "凌晨两点的海"
  },
  {
   "i": 18,
   "start": 99.133,
   "end": 103.2,
   "text": "世界安静得只剩下现在"
  },
  {
   "i": 19,
   "start": 104.366,
   "end": 108.0,
   "text": "若这一刻注定会离开"
  },
  {
   "i": 20,
   "start": 109.566,
   "end": 117.966,
   "text": "至少我们曾被星光拥入怀"
  },
  {
   "i": 21,
